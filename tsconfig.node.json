{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    "outDir": "node_modules/.tsbuild-node",
    "tsBuildInfoFile": "node_modules/.tsbuild-node/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
